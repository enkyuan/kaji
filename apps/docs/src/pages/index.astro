---
import Footer from "@/components/site/footer.astro";
import Demo from "@/components/site/demo.astro";
import Base from "@/layouts/base.astro";
import { ArrowRight, Copy } from "reicon";

const headings = [
  { depth: 2, slug: "what-is-kaji", text: "What is Kaji?" },
  { depth: 2, slug: "how-it-works", text: "How it works" },
  { depth: 2, slug: "core-guarantees", text: "Core guarantees" },
  { depth: 2, slug: "install", text: "Install" },
];
const arrowIcon = ArrowRight.toSvg({
  size: 14,
  color: "currentColor",
  className: "quickstart-icon",
});
const copyIcon = Copy.toSvg({
  size: 14,
  color: "currentColor",
});
---

<Base
  title="Kaji"
  description="Kaji is an embedded execution layer for safely turning agent-requested application actions into real state changes."
  activeHref="/"
  headings={headings}
>
  <article class="article overview-article">
    <header>
      <div class="heading-container">
        <h1 class="hero-title">
          Durable-state execution<span class="hero-stop">.</span><br />
          <span class="forged-underline">For agents.</span>
        </h1>
        <button
          class="install-snippet"
          type="button"
          aria-label="Copy install command"
          data-copy="npm install @irogane/kaji"
        >
          <code>npm install @irogane/kaji</code>
          <Fragment set:html={copyIcon} />
        </button>
      </div>
      <p class="tagline">
        Kaji is an embedded execution layer for safely turning agent-requested application
        actions into real state changes.
      </p>
    </header>

    <Demo />

    <section>
      <h2 id="what-is-kaji">What is Kaji?</h2>
      <p>
        Your application already has functions like <code>refundPayment()</code> or
        <code>cancelBooking()</code>. When an agent, automation, or MCP tool call can trigger one
        of those functions, it needs caller identity, input validation, authorization, human
        approval, and protection against duplicate or ambiguous side effects. Kaji standardizes
        that boundary once, inside your application, instead of once per caller.
      </p>
      <p>
        Kaji is a TypeScript library with zero runtime dependencies. It is not an agent framework,
        model SDK, workflow engine, MCP runtime, or identity provider — your application keeps
        its own domain logic, authorization policy, and remote calls.
      </p>
    </section>

    <section>
      <h2 id="how-it-works">How it works</h2>
      <ol>
        <li><strong>Define</strong> a capability: one application action, its input schema, and its authorization rule.</li>
        <li><strong>Execute</strong> it through Kaji with an explicit caller identity and idempotency key.</li>
        <li><strong>Kaji validates</strong> the input before anything else runs.</li>
        <li><strong>Kaji claims</strong> the idempotency key so duplicates don't execute twice.</li>
        <li><strong>Kaji authorizes and approves</strong>, then calls your <code>execute</code> function at most once.</li>
      </ol>
    </section>

    <section>
      <h2 id="core-guarantees">Core guarantees</h2>
      <ul>
        <li><strong>Explicit identity</strong> — every execution requires a caller-supplied <code>principalId</code>; Kaji never infers one.</li>
        <li><strong>Validation before execution</strong> — invalid input never reaches your authorization or execute code.</li>
        <li><strong>Duplicate suppression</strong> — a repeated idempotency key replays the recorded result instead of running again.</li>
        <li><strong>Explicit failure semantics</strong> — <code>succeeded</code>, <code>failed</code>, and <code>unknown</code> are distinct; an ambiguous side effect is never silently retried.</li>
        <li><strong>Fail-closed approval</strong> — a missing or rejected approval decision prevents execution.</li>
      </ul>
    </section>

    <section class="quickstart-links">
      <p>
        <a href="/docs/getting-started">
          Build your first capability <span aria-hidden="true"><Fragment set:html={arrowIcon} /></span>
        </a>
      </p>
      <p>
        <a href="/docs/concepts/outcomes">
          Understand succeeded, failed, and unknown <span aria-hidden="true"><Fragment set:html={arrowIcon} /></span>
        </a>
      </p>
      <p>
        <a href="/docs/examples/refund">
          Run the refund example <span aria-hidden="true"><Fragment set:html={arrowIcon} /></span>
        </a>
      </p>
    </section>
  </article>

  <Footer />
</Base>
