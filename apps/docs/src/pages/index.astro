---
import Base from "@/layouts/base.astro";
---

<Base title="Kaji" description="Kaji documentation." activeHref="/" shell="standalone">
  <section class="entry-route" aria-label="Kaji documentation">
    <a class="entry-button" href="/introduction">Introduction</a>
  </section>
</Base>

<style>
  .entry-route {
    display: grid;
    min-height: 100svh;
    place-items: center;
  }

  .entry-button {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--line-default);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .entry-button:hover {
    border-color: var(--sango-iro-ink);
    color: var(--sango-iro-ink);
  }

  .entry-button:focus-visible {
    outline: 2px solid var(--gunjo-iro);
    outline-offset: 3px;
  }
</style>
