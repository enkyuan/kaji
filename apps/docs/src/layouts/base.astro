---
import SiteScripts from "@/components/content/scripts.astro";
import Mobile from "@/components/navigation/mobile.astro";
import Sidebar from "@/components/navigation/sidebar.astro";
import { ClientRouter } from "astro:transitions";
import "@/styles/diagram.css";
import "@/styles/global.css";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  activeHref: string;
  headings?: Heading[];
  shell?: "docs" | "standalone";
}

const { title, description, activeHref, headings = [], shell = "docs" } = Astro.props;
const pageTitle = title === "Kaji" ? "Kaji" : `${title} · Kaji`;
const standalone = shell === "standalone";
---

<!doctype html>
<html lang="en" data-shell={shell} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="oklch(0.194 0.006 55.987)" />
    <link rel="icon" href="/favicon.ico?v=1" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon/favicon-196x196.png?v=1" sizes="196x196" />
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png?v=1" sizes="96x96" />
    <link rel="icon" type="image/png" href="/favicon/favicon-32x32.png?v=1" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon/favicon-16x16.png?v=1" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon/favicon-128x128.png?v=1" sizes="128x128" />
    <!-- Explicitly link the root ICO for Safari and legacy tab discovery.
     * The versioned URLs bypass the failed icon response cached before the
     * custom domain became active. -->
    <link rel="mask-icon" href="/logo.svg" color="#f8674f" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon-precomposed" sizes="57x57" href="/favicon/apple-touch-icon-57x57.png" />
    <link rel="apple-touch-icon-precomposed" sizes="114x114" href="/favicon/apple-touch-icon-114x114.png" />
    <link rel="apple-touch-icon-precomposed" sizes="72x72" href="/favicon/apple-touch-icon-72x72.png" />
    <link rel="apple-touch-icon-precomposed" sizes="144x144" href="/favicon/apple-touch-icon-144x144.png" />
    <link rel="apple-touch-icon-precomposed" sizes="60x60" href="/favicon/apple-touch-icon-60x60.png" />
    <link rel="apple-touch-icon-precomposed" sizes="120x120" href="/favicon/apple-touch-icon-120x120.png" />
    <link rel="apple-touch-icon-precomposed" sizes="76x76" href="/favicon/apple-touch-icon-76x76.png" />
    <link rel="apple-touch-icon-precomposed" sizes="152x152" href="/favicon/apple-touch-icon-152x152.png" />
    <link rel="apple-touch-icon-precomposed" sizes="167x167" href="/favicon/apple-touch-icon-167x167.png" />
    <link rel="apple-touch-icon-precomposed" sizes="180x180" href="/favicon/apple-touch-icon-180x180.png" />
    <meta name="application-name" content="&nbsp;" />
    <meta name="msapplication-TileColor" content="#FFFFFF" />
    <meta name="msapplication-TileImage" content="/favicon/mstile-144x144.png" />
    <meta name="msapplication-square70x70logo" content="/favicon/mstile-70x70.png" />
    <meta name="msapplication-square150x150logo" content="/favicon/mstile-150x150.png" />
    <meta name="msapplication-wide310x150logo" content="/favicon/mstile-310x150.png" />
    <meta name="msapplication-square310x310logo" content="/favicon/mstile-310x310.png" />
    <script is:inline data-astro-rerun>
      (() => {
        const root = document.documentElement;
        if (root.dataset.shell !== "docs") return;

        const visitKey = "kaji:visited";

        try {
          if (window.sessionStorage.getItem(visitKey)) {
            root.removeAttribute("data-kaji-motion");
            root.removeAttribute("data-kaji-first-visit");
            return;
          }
          root.dataset.kajiMotion = "";
          root.dataset.kajiFirstVisit = "";
          window.sessionStorage.setItem(visitKey, "true");
        } catch {
          // Storage is optional. Without it, render the shell and diagrams statically.
          root.removeAttribute("data-kaji-motion");
          root.removeAttribute("data-kaji-first-visit");
        }

        if (!root.hasAttribute("data-kaji-first-visit")) return;

        const finishEntrance = () => root.removeAttribute("data-kaji-first-visit");
        const entranceTimer = window.setTimeout(finishEntrance, 6500);
        const cancelEntrance = () => {
          window.clearTimeout(entranceTimer);
          finishEntrance();
        };

        document.addEventListener("astro:before-preparation", cancelEntrance, { once: true });
        window.addEventListener("pagehide", cancelEntrance, { once: true });
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking font load: media="print" keeps the ~1000-rule JP fonts
     * stylesheet out of the render-blocking chain; onload applies it. The
     * &display=swap in the URL renders text in fallback faces until ready. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+JP:wght@100..900&family=Noto+Serif+JP:wght@400;500;600&family=Yuji+Syuku&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+JP:wght@100..900&family=Noto+Serif+JP:wght@400;500;600&family=Yuji+Syuku&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <ClientRouter fallback="swap" />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ "standalone-shell": standalone }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {
      !standalone && (
        <>
          <Mobile activeHref={activeHref} />
          <Sidebar activeHref={activeHref} headings={headings} />
        </>
      )
    }
    <main class:list={["main-content", { "standalone-content": standalone }]} id="main-content">
      <slot />
    </main>
    {import.meta.env.DEV && <div data-agentation-mount />}
    <SiteScripts />
    <script>
      import { setupDiagramMotion } from "@/lib/diagram";

      let cleanupDiagramMotion = () => {};
      let diagramDocument: HTMLElement | null = null;

      const setupDiagrams = () => {
        const main = document.querySelector<HTMLElement>("#main-content");
        if (main === diagramDocument) return;

        diagramDocument = main;
        cleanupDiagramMotion();
        cleanupDiagramMotion = setupDiagramMotion();
      };

      setupDiagrams();
      document.addEventListener("astro:page-load", setupDiagrams);
      window.addEventListener("pagehide", () => cleanupDiagramMotion(), { once: true });
    </script>
  </body>
</html>
