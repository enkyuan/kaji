{
  "name": "kaji",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": ["apps/*", "packages/*", "examples/*"],
  "scripts": {
    "dev": "bun --filter=@kaji/docs dev",
    "build": "bun --filter='*' run build",
    "typecheck": "bun --filter='*' run typecheck",
    "lint": "bun --filter='*' run lint",
    "format": "bun --filter='*' run format",
    "format:check": "bun --filter='*' run format:check",
    "test": "bun --filter=@irogane/kaji run test",
    "package:check": "bun --filter=@irogane/kaji run package:check",
    "package:smoke": "bun --filter=@irogane/kaji run package:smoke",
    "example:refund": "bun --filter=@irogane/kaji-example-refund run start"
  }
}
